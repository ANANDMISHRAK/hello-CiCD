<?xml version="1.0"?>
<!-- Checkstyle configuration is XML; comments explain the rule selection below. -->
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Declares the Checkstyle configuration format. -->
<module name="Checker">
    <!-- The Checker is the top-level module that coordinates all checks. -->
    <property name="charset" value="UTF-8"/>
    <!-- Ensures source files are read consistently as UTF-8. -->
    <property name="severity" value="warning"/>
    <!-- Labels rule violations as warnings; the Maven plugin is configured to fail on violations. -->
    <module name="TreeWalker">
        <!-- TreeWalker examines the Java syntax tree so individual source-code rules can run. -->
        <module name="AvoidInlineConditionals"/>
        <!-- Discourages compact ternary expressions where they reduce readability. -->
        <module name="EmptyStatement"/>
        <!-- Detects empty statements such as an accidental standalone semicolon. -->
        <module name="NeedBraces"/>
        <!-- Requires braces around control-flow bodies such as if and for statements. -->
        <module name="OneStatementPerLine"/>
        <!-- Encourages one statement per source line for readability. -->
        <module name="UnusedImports"/>
        <!-- Detects imports that are not used by the Java source file. -->
    </module>
</module>
